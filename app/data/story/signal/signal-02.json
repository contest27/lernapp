   "audio": "signal-02/p02.mp3",
   "durationSec": 7.97,
   "srcHash": "b8192ef9f6acda805d61e947b20f79be0b9b9b79"
  },
  {
   "id": "p03",
   "speaker": "narrator",
   "text": "Rig looked at his left arm. The metal there was old and orange and rusty. He tried to lift it. It moved, but only a little.",
   "scene": {
    "biome": "forest",
    "time": "night",
    "weather": "rain",
    "actors": [
     {
      "kind": "robot",
      "pos": "centre",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "rock",
      "pos": "right",
      "size": "medium"
     }
    ],
    "relations": [
     {
      "subject": "robot",
      "rel": "next to",
      "object": "rock"
     }
    ]
   },
   "audio": "signal-02/p03.mp3",
   "durationSec": 9.94,
   "srcHash": "3d8cb786409e85427dcfa7ae4c3438792cae477b"
  },
  {
   "id": "p04",
   "speaker": "narrator",
   "text": "The shoulder was damaged. Something in the fall had broken it. Rig did not know how to fix it.",
   "scene": {
    "biome": "forest",
    "time": "night",
    "weather": "rain",
    "actors": [
     {
      "kind": "robot",
      "pos": "centre",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "tree",
      "pos": "right",
      "size": "medium"
     }
    ],
    "relations": []
   },
   "audio": "signal-02/p04.mp3",
   "durationSec": 7.32,
   "srcHash": "570cd5fcb162e8d80586060dd11023697bbe3b5d"
  },
  {
   "id": "p05",
   "speaker": "narrator",
   "text": "He sat under a wide tree and waited. The rain came down all night. In the morning it stopped, and the forest was bright and wet and green.",
   "scene": {
    "biome": "forest",
    "time": "dawn",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "centre",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "tree",
      "pos": "centre",
      "size": "large"
     }
    ],
    "relations": [
