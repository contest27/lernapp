  },
  {
   "id": "p02",
   "speaker": "narrator",
   "text": "A small red light came on inside him. It was a warning. Water was getting in. He had a leak.",
   "scene": {
    "biome": "forest",
    "time": "night",
    "weather": "rain",
    "actors": [
     {
      "kind": "robot",
