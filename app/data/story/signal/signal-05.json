      "size": "medium"
     }
    ],
    "relations": []
   },
   "audio": "signal-05/p01.mp3",
   "durationSec": 7.92,
   "srcHash": "d3d586ec81230557f89903428574c12dbf8793ae"
  },
  {
   "id": "p02",
   "speaker": "narrator",
   "text": "Half buried under the wet earth, he found a crate. It was yellow, and it was still closed.",
   "scene": {
    "biome": "wreck",
    "time": "day",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "left",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "crate",
      "pos": "centre",
      "size": "medium"
     }
    ],
    "relations": []
   },
   "audio": "signal-05/p02.mp3",
   "durationSec": 6.82,
   "srcHash": "9a7532dc7df5ff8d62fb992591d282f79bd5ff31"
  },
  {
   "id": "p03",
   "speaker": "narrator",
   "text": "The lid was heavy. Rig pushed with his good arm for a long time. At last it came open, and he looked inside.",
   "scene": {
    "biome": "wreck",
    "time": "day",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "centre",
      "state": "standing"
     }
    ],
    "props": [
     {
      "kind": "crate",
      "pos": "centre",
      "size": "large"
     }
    ],
    "relations": [
     {
      "subject": "robot",
      "rel": "next to",
      "object": "crate"
     }
    ]
   },
   "audio": "signal-05/p03.mp3",
   "durationSec": 8.35,
   "srcHash": "941d1428ffa53bf645b5698a17d7bc884ec5b70c"
  },
  {
   "id": "p04",
   "speaker": "narrator",
   "text": "Tools. Small ones and big ones. Wire. A short piece of pipe. None of it looked like food, because none of it was.",
   "scene": {
    "biome": "wreck",
    "time": "day",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "right",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "crate",
      "pos": "left",
      "size": "medium"
     }
    ],
    "relations": []
   },
   "audio": "signal-05/p04.mp3",
   "durationSec": 10.2,
   "srcHash": "55874e5509da02cdfa7f7d6c6d93693a9b6dc1a0"
  },
  {
   "id": "p05",
   "speaker": "narrator",
   "text": "Rig took two pieces of wire and touched them together. A bright spark jumped out and died. He did it again. Another spark.",
   "scene": {
    "biome": "wreck",
    "time": "dusk",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "centre",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "crate",
      "pos": "left",
      "size": "small"
     }
    ],
    "relations": []
   },
   "audio": "signal-05/p05.mp3",
   "durationSec": 9.67,
   "srcHash": "185703c95212f27675a68a7a1255ee969cc9f219"
  },
  {
   "id": "p06",
   "speaker": "narrator",
   "text": "He looked at the dry branches by his shelter. Then he looked at the wire in his hand. Rig was old, and slow, and half broken. But he was also clever.",
   "scene": {
    "biome": "forest",
    "time": "dusk",
    "weather": "clear",
