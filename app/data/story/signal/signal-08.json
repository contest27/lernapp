      "subject": "goose",
      "rel": "inside",
      "object": "nest"
     }
    ]
   },
   "audio": "signal-08/p05.mp3",
   "durationSec": 8.09,
   "srcHash": "81a1d0dd5ad3457d6a7e1cf99a08030974e9293f"
  },
  {
   "id": "p06",
   "speaker": "narrator",
   "text": "It opened its beak and made a sound. Rig did not know what the sound meant. But he understood, in the way you understand a thing before you have words for it, that this small grey creature now belonged to him, and he to it.",
   "scene": {
