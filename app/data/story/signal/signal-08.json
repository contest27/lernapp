   "srcHash": "399eca77de30352ab7d63f075bf370ab6e950e63"
  },
  {
   "id": "p02",
   "speaker": "narrator",
   "text": "Rig found it lying on the wet ground. Two of the eggs were cracked and hollow. One was not.",
   "scene": {
    "biome": "forest",
    "time": "dawn",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "left",
      "state": "sitting"
     }
    ],
    "props": [
     {
      "kind": "nest",
      "pos": "centre",
      "size": "medium"
     }
