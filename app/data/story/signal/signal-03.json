      "object": "rock"
     }
    ]
   },
   "audio": "signal-03/p03.mp3",
   "durationSec": 7.03,
   "srcHash": "57c628e099b166461495e39b4f6cc41ea55b1109"
  },
  {
   "id": "p04",
   "speaker": "narrator",
   "text": "At last a small orange face came out of the bushes. It was a fox. She crept forward on narrow feet and stared at him.",
   "scene": {
    "biome": "forest",
    "time": "day",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
      "pos": "left",
      "state": "sitting"
