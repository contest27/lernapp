   "srcHash": "3b8a0f723003ebfcd979357999be3c60e7c0fe1f"
  },
  {
   "id": "p03",
   "speaker": "narrator",
   "text": "Rig sat down on a rock and waited. He waited a long time. He was very good at waiting.",
   "scene": {
    "biome": "forest",
    "time": "day",
    "weather": "clear",
    "actors": [
     {
      "kind": "robot",
