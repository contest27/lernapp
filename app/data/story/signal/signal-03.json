   "audio": "signal-03/p04.mp3",
   "durationSec": 9.17,
   "srcHash": "7fc3c1f6b578a35abc0a5c1736e420b43dddd7c2"
  },
  {
   "id": "p05",
   "speaker": "narrator",
   "text": "Rig did not move. He did not want her to escape. He also did not want to do her any harm.",
   "scene": {
    "biome": "forest",
    "time": "day",
    "weather": "clear",
    "actors": [
